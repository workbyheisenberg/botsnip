# ─────────────────────────────────────────────────────────────
#  Larper — configuration
#  Copy this file to `.env` and edit. Never commit your real .env
# ─────────────────────────────────────────────────────────────

# Robinhood Chain connection (Chain ID 4663)
# Free public RPC works for testing but is slow. Drop in a paid
# fast endpoint here later to make sniping competitive.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: a WebSocket endpoint (paid providers give you one).
# When set, Larper switches from polling to a live subscription.
ROBINHOOD_WS_URL=

# Server port
PORT=8787

# Team login password for the web console
TEAM_PASSWORD=changeme

# Optional. If omitted, a strong key is generated once and stored in
# server/data/.secrets.json (used to encrypt buying-wallet private keys).
MASTER_KEY=

# How often to poll the chain, in milliseconds (free RPC: keep >= 2000)
POLL_INTERVAL_MS=2000

# Resolve hostnames over DNS-over-HTTPS. Leave ON if your ISP hijacks or
# blocks blockchain RPC domains (common on some networks). Set to false to
# use the system resolver.
DNS_OVER_HTTPS=true
DOH_RESOLVER_URL=https://cloudflare-dns.com/dns-query
