{
  "name": "bot-larper",
  "private": true,
  "version": "0.1.0",
  "description": "Larper — internal pons launch sniper console for Robinhood Chain",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace server run typecheck && npm --workspace web run typecheck",
    "alchemy:smoke": "node scripts/alchemy-robinhood-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
